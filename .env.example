# ============================================================================
#  Gemini-Free-API configuration
#  Copy this file to `.env` and edit — or just run start.sh / start.bat
#  and one will be created for you. Every value is optional; real
#  environment variables always override .env values.
# ============================================================================

# ── Google account cookie(s) — OPTIONAL ────────────────────────────────────
# The bridge works with NO cookies (guest mode — verified live), but a
# Google account unlocks higher quotas and the full model registry.
#   How to get the cookies (60 seconds):
#     1. Log in at https://gemini.google.com
#     2. F12 → Application → Cookies → https://gemini.google.com
#     3. Copy `__Secure-1PSID` and `__Secure-1PSIDTS`
#   Three accepted formats:
#     GEMINI_COOKIES=__Secure-1PSID=VALUE; __Secure-1PSIDTS=VALUE
#     GEMINI_COOKIES=[{"psid":"VALUE","psidts":"VALUE"}]
#     GEMINI_COOKIES=VALUE            (just the PSID)
#   Multi-account (round-robin + failover): JSON list with several entries,
#   or several cookie headers separated by commas/newlines.
#   Easiest path: run  ./gemini-login  — a browser opens, you log in, the
#   pair is captured and saved to gemini-cookies.json automatically.
GEMINI_COOKIES=
# GEMINI_COOKIES_FILE=/path/to/gemini-cookies.json   # file form (optional)

# NOTE: Google rotates __Secure-1PSIDTS frequently. The bridge refreshes it
# automatically (RotateCookies + Set-Cookie) and remembers the fresh value in
# gemini-cookies-cache.json — one valid login is usually enough for weeks.

# ── Server ────────────────────────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0
# The key your clients must send (Authorization: Bearer <key> / x-api-key).
# CHANGE THIS if you expose the server beyond localhost!
AUTH_TOKEN=gemini

# ── Thinking (reasoning_content streaming) ────────────────────────────────
# Default for requests that do not state a preference. Clients override per
# request with "reasoning": true/false.
THINKING=true

# ── Multi-account tuning ──────────────────────────────────────────────────
# First rate-limit cooldown in seconds; consecutive hits double it (cap 30 min).
ACCOUNT_COOLDOWN_BASE=120
# How long a request waits in the queue when EVERY account is rate-limited
# or dead, before a 503 is returned (0 = wait forever).
ACCOUNT_QUEUE_TIMEOUT=120

# ── Agent mode (tool calling for agent frameworks) ────────────────────────
# Translates OpenAI/Anthropic tools into agent prompts and rewrites the
# model's <<<TOOL_CALL>>> blocks back into native tool_calls / tool_use.
# Required for OpenCode / Hermes / Cline tool flows.
AGENT_MODE=false
AGENT_MODE_VARIANT=modern

# ── Init token cache TTL (seconds) ────────────────────────────────────────
# How long SNlM0e/bl/f.sid are cached per account (default 1800 = 30 min).
INIT_TOKEN_TTL=1800
